# ---- Server ----
PORT=3000
# Set to true when serving over HTTPS (required for the auth cookie in production)
COOKIE_SECURE=false
# Pino log level: trace | debug | info | warn | error. Defaults to "debug" locally,
# "info" when NODE_ENV=production.
LOG_LEVEL=

# ---- Auth ----
# Generate a long random string, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret

# ---- Encryption for users' own API keys (AES-256-GCM) ----
# 64 hex chars (32 bytes). Optional: if unset, a key is derived from JWT_SECRET.
# Set a dedicated one in production:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# NOTE: changing this (or JWT_SECRET, if you rely on the derived key) makes stored
# user keys unreadable — users would simply re-enter their key.
ENCRYPTION_KEY=

# ---- Database ----
# Local dev (no Docker): SQLite, zero setup. Uses prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ---- Docker / PostgreSQL (used by docker-compose) ----
# docker-compose builds the app against prisma/postgres/schema.prisma and injects a
# Postgres DATABASE_URL automatically — you do NOT set DATABASE_URL for that; it is
# derived from the values below.
POSTGRES_USER=bewerbung
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=bewerbung
# To run `npm start` locally against the dockerized Postgres instead of SQLite:
#   1. uncomment the db `ports:` block in docker-compose.yml and `docker compose up -d db`
#   2. change prisma/schema.prisma provider to "postgresql"
#   3. set DATABASE_URL above to:
#      postgresql://bewerbung:change-me-db-password@localhost:5432/bewerbung?schema=public

# ---- Email (password reset links) ----
# Public base URL used to build reset links (e.g. https://app.example.com).
# If unset, it's derived from the request host.
BASE_URL=
# SMTP for sending reset emails. If left blank, reset links are printed to the SERVER
# CONSOLE instead of emailed (fine for local dev; set these for production).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@bewerbungs-helfer.local

# ---- Built-in / default LLM (the shared key users can opt into) ----
# This is the "built-in AI" option. Users may instead choose their own key in-app.
# Optional: if you leave LLM_API_KEY blank, the built-in option is disabled and every
# user must supply their own key. Never sent to the browser.
# Who may use the built-in key:
#   admins (default) — only admin accounts; everyone else must bring their own key.
#                      Use this for a public deployment so strangers can't spend your budget.
#   all              — every signed-up user (only for private/trusted deployments)
#   none             — nobody; bring-your-own-key only
BUILTIN_AI_ACCESS=admins
# provider: anthropic | openai | gemini
LLM_PROVIDER=anthropic
# model id for that provider (e.g. claude-sonnet-5 / gpt-4o / gemini-2.5-pro)
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
