// Prisma schema. Default datasource is SQLite for zero-setup local runs.
// To use PostgreSQL in production: change `provider` to "postgresql" and set
// DATABASE_URL accordingly, then run `npx prisma migrate dev`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  name         String?
  role         String        @default("user") // "user" | "admin"
  createdAt    DateTime      @default(now())

  // AI model choice
  aiMode       String        @default("default") // "default" (admin key) | "own" (BYOK)
  aiProvider   String? // anthropic | openai | gemini  (when aiMode = "own")
  aiModel      String? //                                 (when aiMode = "own")
  aiKeyEnc     String? // user's own API key, AES-256-GCM encrypted at rest
  aiConfigured Boolean       @default(false) // has the user completed the AI choice step?

  // Password reset
  resetTokenHash String?  // sha256 of the reset token
  resetTokenExp  DateTime? // token expiry

  resume       Resume?
  applications Application[]
}

model Resume {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text         String   @default("")
  originalName String?
  originalType String?
  originalData String? // base64 data URL of the uploaded original file (held for re-download)
  updatedAt    DateTime @updatedAt
}

model Application {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company    String   @default("Unknown")
  role       String   @default("")
  jdLang     String?
  score      Int?
  status     String   @default("To apply")
  coverLang  String?
  jdOriginal String? // long text
  jdEnglish  String? // long text
  analysis   String? // JSON string
  compat     String? // JSON string
  tailored   String? // JSON string
  notes      String? // free-text follow-up notes
  followUpAt DateTime? // when to check back in on this application
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}
